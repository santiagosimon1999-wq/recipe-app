# Copy to .env and fill in values from Supabase Dashboard → Project Settings → API

# Required — Supabase project URL (also used by npm run gen:types)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Required — anon/public key (never use service_role in the browser)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional — Sentry browser DSN (set in Vercel Production only; never commit)
# Get from Sentry → Project Settings → Client Keys (DSN)
# If unset, error monitoring is disabled (no-op). See docs/SENTRY_PRODUCTION.md
# VITE_SENTRY_DSN=

# Optional — override project ref for type generation
# SUPABASE_PROJECT_REF=your_project_ref
