# Copy to .env and fill in values from Supabase Dashboard → Project Settings → API

# Required — Supabase project URL (also used by npm run gen:types)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Required — anon/public key (never use service_role in the browser)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional — Sentry error reporting (production/staging)
# VITE_SENTRY_DSN=

# Optional — override project ref for type generation
# SUPABASE_PROJECT_REF=your_project_ref
